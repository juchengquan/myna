# Server
MYNA_HOST=0.0.0.0
MYNA_PORT=8000
MYNA_LOG_LEVEL=INFO
MYNA_ENV=development

# MCP
MYNA_MCP_SERVER_NAME=myna
MYNA_MCP_MOUNT_PATH=/mcp
# Stateless mode needs no session affinity, but legacy clients can't use
# confirm_action there. Set to false to allow it; multiple replicas then
# need session affinity for legacy clients.
MYNA_MCP_STATELESS=true
# Host and Origin headers accepted on /mcp, as JSON lists. The defaults only
# allow localhost, so remote deployments must set the hosts or get a 421.
# MYNA_MCP_ALLOWED_HOSTS='["myna.example.com"]'
# MYNA_MCP_ALLOWED_ORIGINS='["https://app.example.com"]'

# Limits on stateful sessions, per process. Set to 0 for no limit. These
# have no effect in stateless mode.
# MYNA_MCP_SESSION_IDLE_TIMEOUT_SECONDS=1800
# MYNA_MCP_MAX_SESSIONS=10000

# Admin API auth (set in non-dev environments)
MYNA_ADMIN_API_KEY=

# /metrics auth (set in non-dev environments)
MYNA_METRICS_API_KEY=

# MCP endpoint auth, for machine clients and local development.
# In dev, leave empty to allow anonymous access. In staging/production,
# at least one key must be set or all /mcp traffic is rejected.
# Format: name:key,name:key. The name is the caller in metrics and audit logs.
# Example:  MYNA_MCP_API_KEYS=client-a:sk-abc,client-b:sk-def
# Generate a key:  echo "client-a:$(openssl rand -hex 32)"
MYNA_MCP_API_KEYS=

# Per-caller rate limit on /mcp. Token-bucket: sustained rate of N
# requests per minute, burst capacity = N. Set to 0 to disable.
# Keyed by caller label when authenticated, else by client IP.
MYNA_MCP_RATE_LIMIT_PER_MINUTE=120

# OpenTelemetry tracing. Off by default — flip on to emit spans for
# HTTP requests and MCP tool calls. Without an exporter endpoint,
# spans go to stdout (handy for local development).
MYNA_OTEL_ENABLED=false
MYNA_OTEL_SERVICE_NAME=myna
# MYNA_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces

# Open-Meteo (used by the `get_weather` tool). No API key required.
# Override the Open-Meteo base URLs to point at a mock during tests.
MYNA_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
MYNA_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com
MYNA_OPEN_METEO_TIMEOUT_SECONDS=10.0
